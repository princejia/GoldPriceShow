# goldapi.io 访问令牌（可选）。仅在服务端使用，不会进入浏览器包。
# 不填也能跑：会自动用后面那几个免费、无需 key 的行情源。
GOLDAPI_KEY=

# 备用令牌（可选）。主令牌撞上 401/403/429 时自动切过去，并把主令牌冷却 6 小时。
GOLDAPI_KEY_BACKUP=

# 行情源的尝试顺序（可选）。缺省为下面这串，前面的取不到就自动用后面的。
#   goldapi    — 伦敦现货金，字段最全，但需要 key 且免费额度很小
#   yahoo      — COMEX 黄金期货 GC=F + USD/CNY，免费无 key，带完整 OHLC 和日线历史
#   swissquote — 现货金买卖报价 + USD/CNY，免费无 key，只有当下一笔报价
#   goldapicom — gold-api.com 现货金价 + USD/CNY，免费无 key，字段最少
# 想要更贴近现货的绝对价格（期货带约 1% 升水），可以改成 swissquote,goldapicom,yahoo，
# 代价是涨跌幅和日内区间会变成平的。
GOLD_SOURCES=goldapi,yahoo,swissquote,goldapicom

# 向上游取数的最小间隔（秒）。goldapi 免费额度很小，别调太低。
GOLD_TTL_SECONDS=600

# 「每日区间」回看的交易日数量，0 表示关闭该模块。
GOLD_HISTORY_DAYS=7
